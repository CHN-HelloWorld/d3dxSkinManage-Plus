* text=auto

# 源码与文档统一使用 LF
*.py text eol=lf
*.pyi text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.rc text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.manifest text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.qss text eol=lf
*.svg text eol=lf
*.sh text eol=lf
.editorconfig text eol=lf
.clang-format text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows 脚本与工程文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.props text eol=crlf
*.filters text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.7z binary
*.rar binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
