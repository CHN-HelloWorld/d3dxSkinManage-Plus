{
  "id": "example.preset-cycle",
  "name": "预设轮换",
  "version": "0.1.0",
  "apiVersion": "2.0",
  "files": ["entry.py", "README.md", "languages"],
  "minAppVersion": "1.0.0",
  "author": "d3dxSkinManage-Plus",
  "description": "教学示例：通过快捷键或工具按钮，按列表顺序切换当前游戏的上一个或下一个组合预设。用于演示插件开发，也可实际使用。",
  "entry": "entry.py",
  "permissions": ["mods:read", "mods:write", "storage", "ui:settings", "ui:shortcuts"],
  "contributes": {
    "commands": [
      {"id": "example.preset-cycle.previous", "title": "切换到上一个预设"},
      {"id": "example.preset-cycle.next", "title": "切换到下一个预设"}
    ],
    "settings": [
      {"key": "include_default", "type": "bool", "default": false, "title": "轮换时包含默认预设"}
    ],
    "shortcuts": [
      {"command": "example.preset-cycle.previous", "default": "Ctrl+Alt+PgUp", "context": "window"},
      {"command": "example.preset-cycle.next", "default": "Ctrl+Alt+PgDown", "context": "window"}
    ]
  }
}
