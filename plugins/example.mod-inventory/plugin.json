{
  "id": "example.mod-inventory",
  "name": "Mod 清单导出",
  "version": "0.1.0",
  "apiVersion": "2.0",
  "files": ["entry.py", "inventory.py", "README.md", "languages"],
  "minAppVersion": "1.0.0",
  "author": "d3dxSkinManage-Plus",
  "description": "教学示例：将当前游戏或分类子树的 Mod 信息导出为 CSV，便于整理和分享配置清单。用于演示插件开发，也可实际使用。",
  "entry": "entry.py",
  "permissions": [
    "mods:read",
    "fs:write",
    "background",
    "storage",
    "ui:menus",
    "ui:settings"
  ],
  "contributes": {
    "commands": [
      {"id": "example.mod-inventory.export", "title": "导出 Mod 清单"}
    ],
    "menus": {
      "character-context": [
        {"command": "example.mod-inventory.export", "when": "characterSelected"}
      ]
    },
    "settings": [
      {"key": "enabled_only", "type": "bool", "default": false, "title": "仅导出已启用的 Mod"}
    ]
  }
}
